# Enable rewrite engine
RewriteEngine On
RewriteBase /

# Legacy GWIX trial URL → production exchange
RewriteRule ^gwix-trial/?$ /gwix [R=301,L]

# WDDAM campaign short links
RewriteRule ^wddam/?$ /wddam-campaign/ [R=301,L,NC]
RewriteRule ^medtech/?$ /wddam-campaign/medical-technology/ [R=301,L,NC]
RewriteRule ^cyber/?$ /wddam-campaign/cybersecurity/ [R=301,L,NC]
RewriteRule ^it/?$ /wddam-campaign/information-technology/ [R=301,L,NC]
RewriteRule ^cloud/?$ /wddam-campaign/cloud-data-ai/ [R=301,L,NC]

# Remove .html extension from URLs (clean URLs)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L,QSA]

# Redirect .html to clean URLs (canonical)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.html [NC]
RewriteRule ^ %1 [R=301,L]

# Error handling
ErrorDocument 404 /index.html
ErrorDocument 500 /index.html
