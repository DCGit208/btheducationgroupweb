rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return hasProfile() ? userData().role : '';
    }

    function isSteward() {
      return hasProfile() && role() in ['steward', 'bth_steward', 'admin'];
    }

    function isOperator() {
      return hasProfile() && role() in ['steward', 'bth_steward', 'admin', 'swi', 'swd_inv', 'wds', 'cohort_leader', 'team_leader', 'cohort_member', 'member'];
    }

    function isWds() {
      return hasProfile() && role() == 'wds';
    }

    function isCohortLeader() {
      return hasProfile() && role() in ['cohort_leader', 'team_leader'];
    }

    function operatorCode() {
      return hasProfile() && userData().operatorCode is string ? userData().operatorCode : '';
    }

    function cohortId() {
      return hasProfile() && userData().cohortId is string ? userData().cohortId : '';
    }

    function teamId() {
      return hasProfile() && userData().teamId is string ? userData().teamId : '';
    }

    function memberId() {
      return hasProfile() && userData().memberId is string ? userData().memberId : '';
    }

    function ownsWdsScope() {
      return isWds() && resource.data.wdsCode == operatorCode();
    }

    function validCohortReportCreate() {
      return request.resource.data.keys().hasOnly([
        'cohortId',
        'teamId',
        'leaderCode',
        'type',
        'period',
        'summary',
        'metrics',
        'createdAt',
        'createdBy'
      ]) &&
      request.resource.data.cohortId == cohortId() &&
      request.resource.data.teamId == teamId() &&
      request.resource.data.leaderCode == operatorCode() &&
      request.resource.data.type is string &&
      request.resource.data.type.size() <= 80 &&
      request.resource.data.period is string &&
      request.resource.data.period.size() <= 40 &&
      request.resource.data.summary is string &&
      request.resource.data.summary.size() <= 4000 &&
      (!request.resource.data.keys().hasAny(['metrics']) || request.resource.data.metrics is map) &&
      request.resource.data.createdAt == request.time &&
      request.resource.data.createdBy == request.auth.uid;
    }

    function validCohortApplicationCreate() {
      return request.resource.data.keys().hasOnly([
        'mode',
        'cohortId',
        'wdsCode',
        'sectorId',
        'divisionId',
        'teamId',
        'applicantType',
        'name',
        'email',
        'phone',
        'requestedWorkforceLevel',
        'notes',
        'status',
        'submittedAt',
        'source'
      ]) &&
      request.resource.data.mode in ['model', 'production'] &&
      request.resource.data.cohortId is string &&
      request.resource.data.cohortId.size() > 0 &&
      request.resource.data.cohortId.size() <= 80 &&
      request.resource.data.wdsCode is string &&
      request.resource.data.wdsCode.size() > 0 &&
      request.resource.data.wdsCode.size() <= 80 &&
      request.resource.data.applicantType in ['leader', 'member'] &&
      request.resource.data.name is string &&
      request.resource.data.name.size() > 1 &&
      request.resource.data.name.size() <= 160 &&
      request.resource.data.email is string &&
      request.resource.data.email.size() > 3 &&
      request.resource.data.email.size() <= 254 &&
      request.resource.data.status == 'submitted' &&
      request.resource.data.submittedAt == request.time &&
      request.resource.data.source == 'cohort_signup' &&
      (!request.resource.data.keys().hasAny(['sectorId']) || request.resource.data.sectorId is string) &&
      (!request.resource.data.keys().hasAny(['divisionId']) || request.resource.data.divisionId is string) &&
      (!request.resource.data.keys().hasAny(['teamId']) || request.resource.data.teamId is string) &&
      (!request.resource.data.keys().hasAny(['phone']) || (request.resource.data.phone is string && request.resource.data.phone.size() <= 40)) &&
      (!request.resource.data.keys().hasAny(['requestedWorkforceLevel']) || request.resource.data.requestedWorkforceLevel in ['', '1', '2', '3', '4', '5']) &&
      (!request.resource.data.keys().hasAny(['notes']) || (request.resource.data.notes is string && request.resource.data.notes.size() <= 1000));
    }

    // Operator auth profile — created by steward / Admin SDK
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isSteward());
      allow create, update, delete: if isSteward();
    }

    // Registered operators (SWI · SWD-INV · WDS)
    match /operators/{operatorId} {
      allow read: if isOperator();
      allow create: if signedIn();
      allow update, delete: if isSteward();
    }

    // Per-operator activity log
    match /operator_activities/{activityId} {
      allow read: if isOperator() && (
        isSteward() ||
        resource.data.operatorCode == operatorCode()
      );
      allow create: if isOperator() && (
        request.resource.data.operatorCode == operatorCode() || isSteward()
      );
      allow update, delete: if isSteward();
    }

    // Cohort operating units — steward/WDS governance, leader/member scoped read
    match /cohorts/{id} {
      allow read: if isOperator() && (
        isSteward() ||
        ownsWdsScope() ||
        id == cohortId()
      );
      allow create, update, delete: if isSteward();
    }

    match /cohort_teams/{id} {
      allow read: if isOperator() && (
        isSteward() ||
        ownsWdsScope() ||
        id == teamId() ||
        resource.data.leaderCode == operatorCode()
      );
      allow create, update, delete: if isSteward();
    }

    match /cohort_members/{id} {
      allow read: if isOperator() && (
        isSteward() ||
        ownsWdsScope() ||
        id == memberId() ||
        resource.data.memberCode == operatorCode() ||
        (isCohortLeader() && resource.data.teamId == teamId())
      );
      allow create, update, delete: if isSteward();
    }

    match /cohort_payments/{id} {
      allow read: if isOperator() && (
        isSteward() ||
        ownsWdsScope() ||
        resource.data.memberId == memberId() ||
        resource.data.operatorCode == operatorCode() ||
        (isCohortLeader() && resource.data.teamId == teamId())
      );
      allow create, update, delete: if isSteward();
    }

    match /cohort_reports/{id} {
      allow read: if isOperator() && (
        isSteward() ||
        ownsWdsScope() ||
        resource.data.memberId == memberId() ||
        resource.data.operatorCode == operatorCode() ||
        resource.data.teamId == teamId()
      );
      allow create: if isCohortLeader() && validCohortReportCreate();
      allow update, delete: if isSteward();
    }

    match /cohort_applications/{id} {
      allow create: if validCohortApplicationCreate();
      allow read: if isOperator() && (
        isSteward() ||
        resource.data.wdsCode == operatorCode()
      );
      allow update, delete: if isSteward();
    }

    // Public GWIX econometric feed (read) — steward publishes (write)
    match /gwix_econometric_events/{eventId} {
      allow read: if true;
      allow create: if isSteward();
      allow update, delete: if isSteward();
    }
  }
}
