{
  "functions": {
    "source": "functions",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "*.local"
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "auth": {
    "providers": {
      "emailPassword": true
    }
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "**/.venv*/**",
      "02_SHARED_SERVICES/**",
      "*.md",
      "Gemfile*",
      "Procfile"
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "assets/js/firebase-config.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/gwix-trial",
        "destination": "/gwix",
        "type": 301
      },
      {
        "source": "/gwix-trial.html",
        "destination": "/gwix",
        "type": 301
      },
      {
        "source": "/wddam",
        "destination": "/wddam-campaign/",
        "type": 301
      },
      {
        "source": "/wddam/",
        "destination": "/wddam-campaign/",
        "type": 301
      },
      {
        "source": "/medtech",
        "destination": "/wddam-campaign/medical-technology/",
        "type": 301
      },
      {
        "source": "/medtech/",
        "destination": "/wddam-campaign/medical-technology/",
        "type": 301
      },
      {
        "source": "/cyber",
        "destination": "/wddam-campaign/cybersecurity/",
        "type": 301
      },
      {
        "source": "/cyber/",
        "destination": "/wddam-campaign/cybersecurity/",
        "type": 301
      },
      {
        "source": "/it",
        "destination": "/wddam-campaign/information-technology/",
        "type": 301
      },
      {
        "source": "/it/",
        "destination": "/wddam-campaign/information-technology/",
        "type": 301
      },
      {
        "source": "/cloud",
        "destination": "/wddam-campaign/cloud-data-ai/",
        "type": 301
      },
      {
        "source": "/cloud/",
        "destination": "/wddam-campaign/cloud-data-ai/",
        "type": 301
      }
    ]
  }
}
